{
  "discord": {
    "token": "PUT_DISCORD_TOKEN_IN_ENV",
    "guild_id": "PUT_GUILD_ID_HERE",
    "prefix": "!"
  },

  "youtube": {
    "api_key": "PUT_YOUTUBE_API_KEY_HERE"
  },

  "database": {
    "driver": "sqlite",
    "sqlite": {
      "path": "data/bot.db"
    },
    "mongodb": {
      "uri": "mongodb://localhost:27017",
      "database": "discord_bot"
    }
  },

  "minecraft": {
    "enabled": false,
    "rcon_ip": "localhost",
    "rcon_port": 25575,
    "rcon_password": "PUT_RCON_PASSWORD_HERE"
  },

  "permissions": {
    "admin_roles": [
      "Admin",
      "Owner"
    ],
    "moderator_roles": [
      "Moderator",
      "Mod"
    ],
    "dj_roles": [
      "DJ",
      "Music"
    ]
  },

  "music": {
    "enabled": false,
    "backend": "lavalink",
    "max_queue_size": 100,
    "max_song_duration": 600,
    "allow_playlists": true,
    "default_volume": 50,

    "direct": {
      "ytdlp_path": "./yt-dlp",
      "ffmpeg_path": "ffmpeg"
    },

    "lavalink": {
      "host": "localhost",
      "port": 2333,
      "password": "PUT_LAVALINK_PASSWORD_HERE",
      "secure": false
    }
  },

  "welcome": {
    "enabled": false,
    "channel_id": "PUT_WELCOME_CHANNEL_ID_HERE",

    "embed": {
      "colour": "#f74343",
      "title": "Welcome!",
      "message": "👋 Welcome %joined_user%!",
      "thumbnail": "BOT",
      "image_enabled": false,
      "image_url": ""
    }
  },

  "leave": {
    "enabled": false,
    "channel_id": "PUT_LEAVE_CHANNEL_ID_HERE",

    "embed": {
      "colour": "#f74343",
      "title": "Goodbye!",
      "message": "👋 %joined_user% has left the server.",
      "thumbnail": "BOT",
      "image_enabled": false,
      "image_url": ""
    }
  },

  "moderation": {
    "mod_log_channel": "PUT_MOD_LOG_CHANNEL_ID_HERE",
    "mute_role": "PUT_MUTE_ROLE_ID_HERE",

    "auto_mod": {
      "enabled": false,
      "max_mentions": 5,
      "max_lines": 30,
      "anti_spam_seconds": 5,
      "anti_spam_count": 5
    }
  },

  "link_filter": {
    "enabled": false,
    "allowed_roles": [
      "PUT_ROLE_ID_ALLOWED_TO_POST_LINKS_HERE"
    ],
    "whitelist_domains": [
      "github.com",
      "youtube.com"
    ],
    "block_invites": true,
    "delete_message": true,
    "message": "{user} You are not allowed to post links here."
  },

  "tickets": {
    "enabled": false,
    "panel_channel": "PUT_TICKET_PANEL_CHANNEL_ID_HERE",
    "log_channel": "PUT_TICKET_LOG_CHANNEL_ID_HERE",
    "staff_roles": "PUT_STAFF_ROLE_ID_HERE",
    "discord_category": "PUT_TICKET_CATEGORY_ID_HERE",
    "max_open_per_user": 3,

    "categories": [
      {
        "id": "support",
        "name": "Support",
        "staff_role": "PUT_STAFF_ROLE_ID_HERE",
        "emoji": "🛠️",
        "description": "General support requests",

        "subcategories": [
          {
            "id": "technical",
            "name": "Technical Support",
            "emoji": "🔧",
            "description": "Technical issues and bug reports"
          },

          {
            "id": "general",
            "name": "General",
            "emoji": "❓",
            "description": "General questions"
          }
        ]
      },

      {
        "id": "discord",
        "name": "Discord",
        "staff_role": "PUT_STAFF_ROLE_ID_HERE",
        "emoji": "💬",
        "description": "Discord-related questions",
        "subcategories": []
      },

      {
        "id": "partnership",
        "name": "Partnership",
        "staff_role": "PUT_STAFF_ROLE_ID_HERE",
        "emoji": "🤝",
        "description": "Partnership requests",
        "subcategories": []
      }
    ]
  },

  "commissions": {
    "enabled": false,
    "panel_channel": "PUT_COMMISSION_PANEL_CHANNEL_ID_HERE",
    "log_channel": "PUT_COMMISSION_LOG_CHANNEL_ID_HERE",
    "staff_roles": "PUT_STAFF_ROLE_ID_HERE",
    "discord_category": "PUT_COMMISSION_CATEGORY_ID_HERE",
    "paypal_email": "",
    "paypal_me_user": "",

    "_comment_legal": "Shown as a legal notice at the bottom of invoices. Leave empty to omit. Newlines (\\n) are supported. Example for a French sole trader below.",
    "legal_entity": "Your Company — Type of Business\nSIREN 000 000 000 · SIRET 000 000 000 00000 · Code APE 00.00Z · Country",

    "services": [
      {
        "id": "example",
        "name": "Example Service",
        "emoji": "🛠️",
        "description": "Describe what this service is",
        "starting_price": "50 EUR"
      }
    ]
  },

  "payment": {
    "paypal": {
      "enabled": false,
      "name": "PayPal",
      "button_label": "Pay with PayPal",
      "use_sandbox": false,
      "client_id": "PUT_PAYPAL_CLIENT_ID_HERE",
      "client_secret": "PUT_PAYPAL_CLIENT_SECRET_HERE",
      "merchant_name": "Your Business",
      "merchant_email": "billing@example.com",
      "enable_partial_payments": false,
      "minimum_due_percentage": 0,
      "handling_fee": 0,
      "currency": "USD",
      "payment_notifications": { "type": "polling" }
    },

    "stripe": {
      "enabled": false,
      "name": "Stripe",
      "button_label": "Pay with Stripe",
      "use_sandbox": false,
      "publishable_key": "PUT_STRIPE_PUBLISHABLE_KEY_HERE",
      "secret_key": "PUT_STRIPE_SECRET_KEY_HERE",
      "handling_fee": 0,
      "currency": "USD",
      "success_url": "https://example.com/payment/success",
      "cancel_url": "https://example.com/payment/cancel",
      "payment_notifications": { "type": "polling" }
    },

    "coinbase": {
      "enabled": false,
      "name": "Coinbase",
      "button_label": "Pay with Coinbase",

      "_comment_legacy": "Set api_key for the legacy Coinbase Commerce hosted checkout (X-CC-Api-Key).",
      "api_key": "",

      "_comment_cdp": "OR use the Coinbase App API address flow with a normal Coinbase account. Create a key for the Coinbase App API with wallet permissions, then set both fields below. When set, this takes precedence over api_key.",
      "cdp_key_name": "organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID",
      "cdp_private_key": "YOUR_BASE64_ED25519_PRIVATE_KEY",
      "assets": [
        { "asset": "USDC", "network": "base" },
        { "asset": "BTC" },
        { "asset": "ETH" }
      ],

      "handling_fee": 0,
      "currency": "USD",
      "payment_notifications": { "type": "polling" }
    },

    "webhook": {
      "enabled": false,
      "port": 8080,
      "api_url": "https://api.example.com"
    }
  }
}